---
import "../styles/global.css";
import Header from "../components/header.astro";

---

<main class="pt-20">
    <Header />
    <!-- Hero Section -->
    <section class="relative h-[614px] w-full overflow-hidden">

        <div class="absolute inset-0">
            <img
                alt="Bistró 22 Interior"
                class="w-full h-full object-cover brightness-50"
                data-alt="A wide-angle interior shot of Bistró 22, a high-end futuristic restaurant featuring sleek deep teal surfaces and glowing neon green architectural accents. The atmosphere is immersive and cinematic, with moody, low-key lighting and a subtle haze that catches the neon glows. In the center, a large neon-lit logo of 'Bistró 22' hangs against a dark textured wall, reflecting the premium cyber-gastronomy brand identity."
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuAisaqUg_Qx5QXu1gjFLCO4EJesI1VjSspB2Rmzg_XAKZZnZH6nMGGgsUx4Ya00F0gNvarc1a71Mqqfvnb_tzWn4AMn1vpBCoCOhcCgMye77o5qaepfjGt0C_YFeHF7Te6YpC-rOsBK7anxUauVR-3h7nobh4lzQU0gEz0vibWQKwp3ggGCCrbfqG2YJBezPfsRPLnWjf1UO6NbW4kavY7R2ZWzLG12iv-GaVv0kSYha7j9Dk-dQVsgGZfxkqAJ45UtkPR0pWC8tR5Y"
            />
        </div>
        <div
            class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent"
        >
        </div>
        <div
            class="relative h-full max-w-[1440px] mx-auto px-8 flex flex-col justify-center"
        >
            <div class="flex items-center gap-4 mb-4">
                <span
                    class="px-3 py-1 bg-[#CCFF00] text-[#161e00] font-label-lg text-label-lg rounded-full"
                    >PREMIUM DESTINATION</span
                >
            </div>
            <h1
                class="font-headline-xl text-headline-xl text-[#CCFF00] neon-text uppercase mb-2"
            >
                Bistró 22
            </h1>
            <p class="text-white/80 font-body-lg text-body-lg max-w-xl">
                Elevating the senses through fusion technology and high-fidelity
                culinary arts.
            </p>
        </div>
    </section>
    <!-- Content Grid -->
    <section
        class="max-w-[1440px] mx-auto px-8 py-16 grid grid-cols-1 md:grid-cols-12 gap-12"
    >
        <!-- Left Column: Business Info -->
        <aside class="md:col-span-4 space-y-8">
            <!-- Info Card -->
            <div
                class="bg-surface-container rounded-lg p-lg border border-white/5 space-y-6 shadow-xl"
            >
                <div class="flex items-center justify-between">
                    <span
                        class="font-headline-md text-headline-md text-[#CCFF00]"
                        >4.9</span
                    >
                    <div class="flex text-[#CCFF00]">
                        <span
                            class="material-symbols-outlined"
                            style="font-variation-settings: 'FILL' 1;"
                            >star</span
                        >
                        <span
                            class="material-symbols-outlined"
                            style="font-variation-settings: 'FILL' 1;"
                            >star</span
                        >
                        <span
                            class="material-symbols-outlined"
                            style="font-variation-settings: 'FILL' 1;"
                            >star</span
                        >
                        <span
                            class="material-symbols-outlined"
                            style="font-variation-settings: 'FILL' 1;"
                            >star</span
                        >
                        <span
                            class="material-symbols-outlined"
                            style="font-variation-settings: 'FILL' 1;"
                            >star_half</span
                        >
                    </div>
                </div>
                <div class="space-y-4 pt-4 border-t border-white/5">
                    <div
                        class="flex items-center gap-3 text-on-surface-variant"
                    >
                        <span
                            class="material-symbols-outlined text-[#CCFF00]"
                            data-icon="restaurant">restaurant</span
                        >
                        <span class="font-label-lg text-label-lg"
                            >European Fusion</span
                        >
                    </div>
                    <div
                        class="flex items-center gap-3 text-on-surface-variant"
                    >
                        <span
                            class="material-symbols-outlined text-[#CCFF00]"
                            data-icon="call">call</span
                        >
                        <span class="font-label-lg text-label-lg"
                            >+34 912 345 678</span
                        >
                    </div>
                    <div
                        class="flex items-center gap-3 text-on-surface-variant"
                    >
                        <span
                            class="material-symbols-outlined text-[#CCFF00]"
                            data-icon="language">language</span
                        >
                        <span class="font-label-lg text-label-lg"
                            >www.bistro22.io</span
                        >
                    </div>
                    <div class="flex items-start gap-3 text-on-surface-variant">
                        <span
                            class="material-symbols-outlined text-[#CCFF00]"
                            data-icon="location_on">location_on</span
                        >
                        <span class="font-label-lg text-label-lg"
                            >Calle de la Innovación 22, Cyber-District, Madrid</span
                        >
                    </div>
                </div>
                <!-- Map Preview -->
                <div
                    class="w-full h-40 rounded-DEFAULT overflow-hidden grayscale contrast-125 brightness-75 border border-[#004D54]"
                >
                    <img
                        alt="Location Map"
                        class="w-full h-full object-cover"
                        data-alt="A stylized, high-contrast digital map interface showing the neighborhood around Bistró 22 in Madrid. The map uses a dark color palette with glowing neon teal streets and a prominent neon green pulse marker indicating the restaurant's location. The aesthetic is futuristic and data-driven, fitting a high-end cyber-gastronomy navigation experience."
                        data-location="Madrid"
                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuAywH4gE2Okio8iVS-Y4NHqavZRagVWp887paxqyJ4qeW2qYSqffpglMi2s-pNkPHJ5_cJqswlAZQKplz0oUaO7ptj88Wp9UHTHpw_oRtibxQD3sKrinEgtL3JgeAdHa8JbHMnv6jju0-WelktSnR_qRrW4JYFqhIqYDO451adlA34GaWzXxIR0PNRO4SVCK-pPMwDR8bq02c8mepfa9ELHD2ai0Tpwr3erthxrfVj7kTEj4wDa3KHXdl5DlcBcV86ZcJUTE8Tclhkh"
                    />
                </div>
            </div>
            <!-- Score Breakdown Cards -->
            <div class="grid grid-cols-2 gap-4">
                <div
                    class="bg-surface-container-high p-md rounded-DEFAULT border border-white/5 text-center flex flex-col items-center gap-2"
                >
                    <span
                        class="text-label-md font-label-md text-white/50 uppercase tracking-widest"
                        >Food</span
                    >
                    <div
                        class="w-16 h-16 rounded-full border-2 border-[#CCFF00] flex items-center justify-center neon-border-glow"
                    >
                        <span
                            class="font-headline-md text-headline-md text-[#CCFF00]"
                            >5.0</span
                        >
                    </div>
                </div>
                <div
                    class="bg-surface-container-high p-md rounded-DEFAULT border border-white/5 text-center flex flex-col items-center gap-2"
                >
                    <span
                        class="text-label-md font-label-md text-white/50 uppercase tracking-widest"
                        >Location</span
                    >
                    <div
                        class="w-16 h-16 rounded-full border-2 border-white/20 flex items-center justify-center"
                    >
                        <span
                            class="font-headline-md text-headline-md text-white"
                            >4.8</span
                        >
                    </div>
                </div>
                <div
                    class="bg-surface-container-high p-md rounded-DEFAULT border border-white/5 text-center flex flex-col items-center gap-2"
                >
                    <span
                        class="text-label-md font-label-md text-white/50 uppercase tracking-widest"
                        >Atmosphere</span
                    >
                    <div
                        class="w-16 h-16 rounded-full border-2 border-[#CCFF00] flex items-center justify-center neon-border-glow"
                    >
                        <span
                            class="font-headline-md text-headline-md text-[#CCFF00]"
                            >4.9</span
                        >
                    </div>
                </div>
                <div
                    class="bg-surface-container-high p-md rounded-DEFAULT border border-white/5 text-center flex flex-col items-center gap-2"
                >
                    <span
                        class="text-label-md font-label-md text-white/50 uppercase tracking-widest"
                        >Comfort</span
                    >
                    <div
                        class="w-16 h-16 rounded-full border-2 border-white/20 flex items-center justify-center"
                    >
                        <span
                            class="font-headline-md text-headline-md text-white"
                            >4.7</span
                        >
                    </div>
                </div>
            </div>
        </aside>
        <!-- Right Column: Description & Reviews -->
        <article class="md:col-span-8 space-y-16">
            <!-- Description -->
            <div class="space-y-6">
                <h2 class="font-headline-lg text-headline-lg text-white">
                    The Future of Flavor
                </h2>
                <div class="prose prose-invert max-w-none">
                    <p
                        class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed"
                    >
                        Bistró 22 is not just a restaurant; it's a sensory
                        gateway. Located in the heart of the tech district, we
                        merge molecular gastronomy with traditional European
                        roots. Our chefs use precision thermal control and
                        hyper-fresh ingredients sourced from local vertical
                        farms to create dishes that defy expectations.
                    </p>
                    <p
                        class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed mt-4"
                    >
                        Every detail, from the haptic table surfaces to the
                        reactive ambient lighting, is designed to complement our
                        seasonal tasting menus. Experience a culinary journey
                        where technology and tradition meet on the edge of
                        tomorrow.
                    </p>
                </div>
            </div>
            <!-- Reviews Section -->
            <section class="space-y-8">
                <div
                    class="flex items-center justify-between border-b border-white/10 pb-6"
                >
                    <h3
                        class="font-headline-md text-headline-md text-[#CCFF00] uppercase tracking-tighter"
                    >
                        Guest Experiences
                    </h3>
                    <button
                        class="px-8 py-3 bg-[#CCFF00] text-[#161e00] font-label-lg text-label-lg rounded-full hover:shadow-[0_0_20px_rgba(204,255,0,0.4)] transition-all active:scale-95"
                    >
                        Write a Review
                    </button>
                </div>
                <!-- Reviews Feed -->
                <div class="space-y-6">
                    <!-- Review 1 -->
                    <div
                        class="bg-surface-container rounded-lg p-lg border border-white/5 space-y-6"
                    >
                        <div class="flex items-start justify-between">
                            <div class="flex items-center gap-4">
                                <div
                                    class="w-12 h-12 rounded-full overflow-hidden border border-[#CCFF00]"
                                >
                                    <img
                                        alt="User Avatar"
                                        class="w-full h-full object-cover"
                                        data-alt="A portrait of a vibrant young woman with a creative professional look, featuring soft cinematic lighting and a dark background. She has a warm, sophisticated expression. The lighting includes subtle neon reflections that tie into the futuristic cyber-gastronomy theme of the review platform."
                                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuC4DKDyf16oy8wspK-whHMqRPmixVDYmVvc0MjZ790viwEWNZPbKe-lW4iLnqFrq1iLT2R5o0uqHTR6vj2_5lkf3tqFGMGzPkiMzTcxK-B5kWdyQQv6bGyjiTzaRxKVqYMxftzN6K0Xr0WTDt4jWQN1LMq6LFJkZL4KMmZMd9hpYYfGNn8FKB0FkE-5d7Mie-FUWczQsvSZ0pk0nVyhQlw32MIk_MSVt9ylGXwhm_isHWDqhm4D_lhXBNaBKcEGb6o6g8iHAvprU5O4"
                                    />
                                </div>
                                <div>
                                    <h4
                                        class="font-label-lg text-label-lg text-white"
                                    >
                                        Elena Vance
                                    </h4>
                                    <p
                                        class="text-xs text-white/40 uppercase tracking-widest"
                                    >
                                        October 14, 2024
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-[#CCFF00]/10 px-3 py-1 rounded-full border border-[#CCFF00]/20"
                            >
                                <span class="text-[#CCFF00] font-bold">5.0</span
                                >
                            </div>
                        </div>
                        <p
                            class="font-body-md text-body-md text-on-surface-variant"
                        >
                            "An absolute revelation. The liquid nitrogen
                            gazpacho was a standout. The atmosphere feels like
                            stepping into a high-budget sci-fi film, but the
                            warmth of the service keeps it grounded and
                            welcoming."
                        </p>
                        <div
                            class="flex flex-wrap gap-4 pt-4 border-t border-white/5"
                        >
                            <div class="flex items-center gap-2">
                                <span
                                    class="text-[10px] uppercase tracking-tighter text-white/40"
                                    >Food:</span
                                >
                                <span class="text-xs font-bold text-[#CCFF00]"
                                    >5.0</span
                                >
                            </div>
                            <div class="flex items-center gap-2">
                                <span
                                    class="text-[10px] uppercase tracking-tighter text-white/40"
                                    >Service:</span
                                >
                                <span class="text-xs font-bold text-[#CCFF00]"
                                    >4.9</span
                                >
                            </div>
                            <div class="flex items-center gap-2">
                                <span
                                    class="text-[10px] uppercase tracking-tighter text-white/40"
                                    >Vibe:</span
                                >
                                <span class="text-xs font-bold text-[#CCFF00]"
                                    >5.0</span
                                >
                            </div>
                            <div class="flex items-center gap-2">
                                <span
                                    class="text-[10px] uppercase tracking-tighter text-white/40"
                                    >Price:</span
                                >
                                <span class="text-xs font-bold text-[#CCFF00]"
                                    >4.5</span
                                >
                            </div>
                        </div>
                    </div>
                    <!-- Review 2 -->
                    <div
                        class="bg-surface-container rounded-lg p-lg border border-white/5 space-y-6 opacity-80"
                    >
                        <div class="flex items-start justify-between">
                            <div class="flex items-center gap-4">
                                <div
                                    class="w-12 h-12 rounded-full overflow-hidden border border-white/10"
                                >
                                    <img
                                        alt="User Avatar"
                                        class="w-full h-full object-cover"
                                        data-alt="A portrait of a mature man with a distinguished, scholarly appearance, captured with soft-key lighting against a deep dark background. His expression is thoughtful and appreciative. The visual style is consistent with a luxury digital environment, using high-fidelity photography and deep color tones."
                                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuDSHlFQKWIADn7q5v2JZ88LE1h67PmwLcXEx5w3heO3CCFJpMUrZlvUfUQQAaELOsC_878i1WnKPgzl17iqXN6bq4XoCOeaU0kwok5pfBkZ-_E-xl5Qx6iJy6frQAGSXba6vTKoZkKFeQR0N2lYwrutExcp35SQo_y1uPA1ahXP_ljYUEx_8oH8iQCkAJpCVTnYZ1HzIjOrPYF-om9WqKUKOLMzLP4K2pBtvYsbeR4O0eejwHuZcjsF9LG_Uvs-m_AVLpQmMjjlF4Br"
                                    />
                                </div>
                                <div>
                                    <h4
                                        class="font-label-lg text-label-lg text-white"
                                    >
                                        Julian Castor
                                    </h4>
                                    <p
                                        class="text-xs text-white/40 uppercase tracking-widest"
                                    >
                                        October 09, 2024
                                    </p>
                                </div>
                            </div>
                            <div
                                class="bg-white/5 px-3 py-1 rounded-full border border-white/10"
                            >
                                <span class="text-white font-bold">4.8</span>
                            </div>
                        </div>
                        <p
                            class="font-body-md text-body-md text-on-surface-variant"
                        >
                            "The integration of digital elements in the dining
                            experience is seamless. Highly recommend the
                            deconstructed Iberian ham—it's a masterclass in
                            texture."
                        </p>
                        <div
                            class="flex flex-wrap gap-4 pt-4 border-t border-white/5"
                        >
                            <div class="flex items-center gap-2">
                                <span
                                    class="text-[10px] uppercase tracking-tighter text-white/40"
                                    >Food:</span
                                >
                                <span class="text-xs font-bold text-white"
                                    >4.8</span
                                >
                            </div>
                            <div class="flex items-center gap-2">
                                <span
                                    class="text-[10px] uppercase tracking-tighter text-white/40"
                                    >Service:</span
                                >
                                <span class="text-xs font-bold text-white"
                                    >4.7</span
                                >
                            </div>
                            <div class="flex items-center gap-2">
                                <span
                                    class="text-[10px] uppercase tracking-tighter text-white/40"
                                    >Vibe:</span
                                >
                                <span class="text-xs font-bold text-white"
                                    >5.0</span
                                >
                            </div>
                            <div class="flex items-center gap-2">
                                <span
                                    class="text-[10px] uppercase tracking-tighter text-white/40"
                                    >Price:</span
                                >
                                <span class="text-xs font-bold text-white"
                                    >4.0</span
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </article>
    </section>
</main>
