---
import "../styles/global.css";
import Header from "../components/header.astro";
---
<main class="pb-32 pt-16">
    <Header />
    <!-- Hero Section -->
    <section class="relative h-[530px] w-full overflow-hidden">
                <div
                    class="absolute inset-0 bg-gradient-to-t from-[#001718] via-transparent to-transparent z-10"
                >
                </div>
                <img
                    class="w-full h-full object-cover"
                    data-alt="A futuristic interior of a luxury restaurant with sleek dark teal surfaces and vibrant neon green lighting accents. The central wall features a massive, glowing neon typography sign that reads 'Bistró 22' in a stylized high-tech font. The atmosphere is immersive and high-energy with a deep cinematic aesthetic, shot from a low angle to emphasize the architectural scale and the moody, cyber-gastronomy vibe. Soft volumetric lighting fills the air, creating a premium digital lounge feel."
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuBQ0Y5x1NcNfRDw_EthEIC57MHGUT9WNVe620BvrP46zFcJHHOk-lSncG3U8CKiYOcJT4dyW58MbQnQzT5w9m2SHk2n3w98qpCT96zC6j00Ac3hIKrMVYZeORxCUwNFjs31FxXyRbIY4yTqk-t46NpYa2dlCEgEkIzXfRa018zqzSDuc_dr8B3jzEWHIfnAdz2usVO8avTYqV-9RMvcGyjyH2j-CvqB24CwaKr19GO2W0_gHnkyqHQ3eEkYcDlnv3NaWTC2ZVcFWSWJ"
                />
                <div
                    class="absolute inset-0 z-20 flex flex-col justify-end px-margin pb-xl"
                >
                    <span
                        class="inline-block px-sm py-xs bg-[#CCFF00] text-[#001A1C] font-label-lg rounded-sm mb-md w-fit"
                        >OPEN NOW</span
                    >
                    <h2 class="font-headline-xl text-primary neon-glow italic">
                        Bistró 22
                    </h2>
                    <div class="flex items-center gap-sm mt-sm">
                        <span
                            class="material-symbols-outlined text-[#CCFF00] fill-1"
                            data-icon="star"
                            style="font-variation-settings: 'FILL' 1;"
                            >star</span
                        >
                        <p class="font-headline-md text-primary">4.9</p>
                        <span class="text-white/40 font-body-md"
                            >(2,482 Reviews)</span
                        >
                    </div>
                </div>
            </section>
            <!-- Info Section (Two Columns) -->
            <section
                class="px-margin py-xl grid grid-cols-1 md:grid-cols-2 gap-xl"
            >
                <!-- Left: Contact & Location -->
                <div class="space-y-lg">
                    <div class="glass-card rounded-lg p-lg space-y-md">
                        <div class="flex items-center gap-md">
                            <div
                                class="w-10 h-10 rounded-full bg-[#CCFF00]/10 flex items-center justify-center text-[#CCFF00]"
                            >
                                <span
                                    class="material-symbols-outlined"
                                    data-icon="restaurant">restaurant</span
                                >
                            </div>
                            <div>
                                <p
                                    class="text-white/50 text-xs font-label-md uppercase tracking-wider"
                                >
                                    Category
                                </p>
                                <p class="font-headline-md text-primary">
                                    European Fusion
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-md">
                            <div
                                class="w-10 h-10 rounded-full bg-[#CCFF00]/10 flex items-center justify-center text-[#CCFF00]"
                            >
                                <span
                                    class="material-symbols-outlined"
                                    data-icon="call">call</span
                                >
                            </div>
                            <div>
                                <p
                                    class="text-white/50 text-xs font-label-md uppercase tracking-wider"
                                >
                                    Phone
                                </p>
                                <p class="font-body-lg text-on-background">
                                    +57 (311) 222-0022
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-md">
                            <div
                                class="w-10 h-10 rounded-full bg-[#CCFF00]/10 flex items-center justify-center text-[#CCFF00]"
                            >
                                <span
                                    class="material-symbols-outlined"
                                    data-icon="language">language</span
                                >
                            </div>
                            <div>
                                <p
                                    class="text-white/50 text-xs font-label-md uppercase tracking-wider"
                                >
                                    Website
                                </p>
                                <p class="font-body-lg text-primary underline">
                                    www.bistro22.com
                                </p>
                            </div>
                        </div>
                        <div
                            class="flex items-start gap-md pt-md border-t border-white/5"
                        >
                            <div
                                class="w-10 h-10 rounded-full bg-[#CCFF00]/10 flex items-center justify-center text-[#CCFF00] shrink-0"
                            >
                                <span
                                    class="material-symbols-outlined"
                                    data-icon="location_on">location_on</span
                                >
                            </div>
                            <div>
                                <p
                                    class="text-white/50 text-xs font-label-md uppercase tracking-wider"
                                >
                                    Address
                                </p>
                                <p class="font-body-lg text-on-background">
                                    Cra 43A #1-50, Medellín, Antioquia
                                </p>
                                <div
                                    class="mt-md rounded-md overflow-hidden h-32 w-full relative"
                                >
                                    <img
                                        class="w-full h-full object-cover grayscale opacity-50"
                                        data-alt="A stylized, dark-themed satellite map of the Poblado district in Medellín. The map features high-contrast lines and a glowing neon green pin marking the location of Bistró 22. The aesthetic is clean and futuristic, matching the cyber-gastronomy interface of the app."
                                        data-location="Medellín"
                                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuAcLJCuiB5hV_rbholxhSj1mUF1i7b9FHwoaMKuCoDwtMvegatqoXItcOK96KrV0NFE_JZ3lszBslICr-B7HieSLpSSpuIH1iwdpWr0cJNGChVM_nv-qVtyzzgtGG73KGHxCurCBHAcmHxxYythn3F4BjBJJ6i5-_BDDEkornfITvgSBCtUldWZoOxbdApTN4vsG4tAUTUIHU6Fwmky7QG1p8GiBd_PQV5t94F-Q54aBLfnGsKaILBmZNgL979_VWdANi8HB89XpC1I"
                                    />
                                    <div
                                        class="absolute inset-0 bg-[#CCFF00]/5 flex items-center justify-center"
                                    >
                                        <span
                                            class="material-symbols-outlined text-[#CCFF00] text-3xl"
                                            data-icon="location_on"
                                            style="font-variation-settings: 'FILL' 1;"
                                            >location_on</span
                                        >
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Right: Description -->
                <div class="space-y-lg">
                    <div class="glass-card rounded-lg p-lg h-full">
                        <h3
                            class="font-headline-lg text-[#CCFF00] mb-lg italic"
                        >
                            The Future of Flavor
                        </h3>
                        <p
                            class="font-body-lg text-on-background/80 leading-relaxed"
                        >
                            Step into a realm where high-end culinary arts
                            collide with a futuristic tech-driven interface.
                            Bistró 22 isn't just a restaurant; it's a sensory
                            immersion. Our chefs utilize molecular gastronomy
                            techniques to redefine European classics, served in
                            a high-contrast environment of deep teals and neon
                            accents.
                        </p>
                        <p
                            class="font-body-lg text-on-background/80 mt-md leading-relaxed"
                        >
                            Every plate is designed as a digital artifact—as
                            much a visual masterpiece as it is a gastronomic
                            delight. Experience the 'Cyber-Gastronomy' movement
                            in the heart of Medellín.
                        </p>
                        <div class="mt-xl flex flex-wrap gap-sm">
                            <span
                                class="px-md py-xs rounded-full border border-[#CCFF00]/30 text-[#CCFF00] font-label-md"
                                >Molecular Food</span
                            >
                            <span
                                class="px-md py-xs rounded-full border border-[#CCFF00]/30 text-[#CCFF00] font-label-md"
                                >Exclusive Atmosphere</span
                            >
                            <span
                                class="px-md py-xs rounded-full border border-[#CCFF00]/30 text-[#CCFF00] font-label-md"
                                >Gourmet Tech</span
                            >
                        </div>
                    </div>
                </div>
            </section>
            <!-- Rating Breakdown -->
            <section class="px-margin py-xl bg-surface-container">
                <h3 class="font-headline-lg text-primary mb-xl">
                    Atmosphere &amp; Service
                </h3>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-lg">
                    <div
                        class="glass-card p-lg rounded-lg text-center border-b-4 border-[#CCFF00]"
                    >
                        <p class="text-white/50 font-label-md uppercase mb-sm">
                            Food Quality
                        </p>
                        <p class="font-headline-xl text-[#CCFF00]">5.0</p>
                    </div>
                    <div class="glass-card p-lg rounded-lg text-center">
                        <p class="text-white/50 font-label-md uppercase mb-sm">
                            Location
                        </p>
                        <p class="font-headline-xl text-primary">4.5</p>
                    </div>
                    <div
                        class="glass-card p-lg rounded-lg text-center border-b-4 border-[#CCFF00]"
                    >
                        <p class="text-white/50 font-label-md uppercase mb-sm">
                            Atmosphere
                        </p>
                        <p class="font-headline-xl text-[#CCFF00]">5.0</p>
                    </div>
                    <div class="glass-card p-lg rounded-lg text-center">
                        <p class="text-white/50 font-label-md uppercase mb-sm">
                            Comfort
                        </p>
                        <p class="font-headline-xl text-primary">4.8</p>
                    </div>
                </div>
            </section>
            <!-- Reviews Section -->
            <section class="px-margin py-xl">
                <div class="flex justify-between items-end mb-xl">
                    <div>
                        <h3 class="font-headline-lg text-primary">
                            Guest Experiences
                        </h3>
                        <p class="text-white/40 font-body-md mt-xs">
                            Sharing the digital gastronomy journey
                        </p>
                    </div>
                    <button
                        class="bg-[#CCFF00] text-[#001A1C] px-xl py-md rounded-full font-label-lg font-bold hover:shadow-[0_0_20px_rgba(204,255,0,0.4)] transition-all"
                    >
                        Write a Review
                    </button>
                </div>
                <div class="space-y-lg">
                    <!-- Review 1 -->
                    <article
                        class="glass-card rounded-lg p-lg border-l-4 border-[#CCFF00]"
                    >
                        <div class="flex justify-between items-start mb-lg">
                            <div class="flex items-center gap-md">
                                <div
                                    class="w-12 h-12 rounded-full overflow-hidden border-2 border-[#CCFF00]"
                                >
                                    <img
                                        class="w-full h-full object-cover"
                                        data-alt="A portrait of a stylish male customer in a modern dark lounge environment. He is wearing high-end tech-wear inspired clothing. The lighting is low and moody with a subtle green backlight that makes him pop from the dark background. He has a satisfied, confident expression, fitting the premium aesthetic of the cyber-gastronomy brand."
                                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuBHbaVmZr_F8zRc3hjeOkkJnhvZhMWIcdUUFfAGgx1HPLC5fdwMx-To6OVK8o5h57GpqTLoqPXEnXwyUXAkYhLBEdfXYFPOtuYUyZDRHdmdsuh1Hoc1tZmFHkgRGPhhiRbfrSqiHjZUrEzZTyD-EratoWi6JZhXyGaC98vVHYZzerUi3yXdVklmkR1b06hD-E4-aaLUku_MqlRHG21B3uOMrVPP7Dhtayhm1cOiM0lPRXTBdmiQiPX57_uwnD31v9npwm7ieU0bVPUE"
                                    />
                                </div>
                                <div>
                                    <p class="font-headline-md text-primary">
                                        Julian R.
                                    </p>
                                    <p class="text-white/40 font-label-md">
                                        Local Guide • 12 Reviews
                                    </p>
                                </div>
                            </div>
                            <div
                                class="flex items-center gap-xs px-md py-sm bg-[#CCFF00]/10 rounded-full text-[#CCFF00]"
                            >
                                <span
                                    class="material-symbols-outlined text-sm"
                                    data-icon="star"
                                    style="font-variation-settings: 'FILL' 1;"
                                    >star</span
                                >
                                <span class="font-bold">5.0</span>
                            </div>
                        </div>
                        <p
                            class="font-body-lg text-on-background/90 italic leading-relaxed mb-lg"
                        >
                            "The neon lighting and the soundscape create an
                            atmosphere I haven't seen anywhere else. The
                            truffle-infused nitrogen desserts were literally
                            life-changing. A true cyber-gastronomy peak."
                        </p>
                        <div
                            class="grid grid-cols-2 md:grid-cols-4 gap-md pt-lg border-t border-white/5"
                        >
                            <div class="text-center">
                                <p
                                    class="text-[10px] uppercase font-label-md text-white/30"
                                >
                                    Food
                                </p>
                                <p class="text-[#CCFF00] font-bold">5.0</p>
                            </div>
                            <div class="text-center">
                                <p
                                    class="text-[10px] uppercase font-label-md text-white/30"
                                >
                                    Service
                                </p>
                                <p class="text-primary font-bold">4.8</p>
                            </div>
                            <div class="text-center">
                                <p
                                    class="text-[10px] uppercase font-label-md text-white/30"
                                >
                                    Vibe
                                </p>
                                <p class="text-[#CCFF00] font-bold">5.0</p>
                            </div>
                            <div class="text-center">
                                <p
                                    class="text-[10px] uppercase font-label-md text-white/30"
                                >
                                    Price
                                </p>
                                <p class="text-primary font-bold">4.0</p>
                            </div>
                        </div>
                    </article>
                    <!-- Review 2 -->
                    <article class="glass-card rounded-lg p-lg">
                        <div class="flex justify-between items-start mb-lg">
                            <div class="flex items-center gap-md">
                                <div
                                    class="w-12 h-12 rounded-full overflow-hidden border-2 border-white/20"
                                >
                                    <img
                                        class="w-full h-full object-cover"
                                        data-alt="A portrait of a chic young woman in a dimly lit, futuristic restaurant setting. Her face is softly illuminated by the glow of a nearby neon green table accent. She has a curious, exploratory look on her face. The background is a soft bokeh of deep teals and cyan lights, embodying the high-end digital lounge vibe of Bistró 22."
                                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuCbfwV1dnDjc7KPdfB9AtO4M_iKKBOpLlU535POQaNG7QO2VBKQl7CRmF-EvqKmqp8gqLhvdQy1uJglBx7OeHAqF-7ZZ4siVs2EduYzL2Gw7ln0i2nzL3HHk8IdFukK2H9G3PhxvGz5Rl1DsVmPwc1uG4CmO2VQdRYeraCVvRltEpdD1G146QOn9zdgukrXgg3o4dyp1AF1b64ylBVrBUKBD7A4JNuB1jjNqAdi-w1HQ-6Di7vKRAHyPzjq2KsS0OdJpZKwhNNOBbGW"
                                    />
                                </div>
                                <div>
                                    <p class="font-headline-md text-primary">
                                        Mariana V.
                                    </p>
                                    <p class="text-white/40 font-label-md">
                                        Member since 2023
                                    </p>
                                </div>
                            </div>
                            <div
                                class="flex items-center gap-xs px-md py-sm bg-white/5 rounded-full text-white/70"
                            >
                                <span
                                    class="material-symbols-outlined text-sm"
                                    data-icon="star"
                                    style="font-variation-settings: 'FILL' 1;"
                                    >star</span
                                >
                                <span class="font-bold">4.5</span>
                            </div>
                        </div>
                        <p
                            class="font-body-lg text-on-background/90 leading-relaxed mb-lg"
                        >
                            "Waitlist was long but worth it. The attention to
                            detail in the presentation is incredible. Every
                            course feels like a piece of art."
                        </p>
                        <div
                            class="grid grid-cols-2 md:grid-cols-4 gap-md pt-lg border-t border-white/5"
                        >
                            <div class="text-center">
                                <p
                                    class="text-[10px] uppercase font-label-md text-white/30"
                                >
                                    Food
                                </p>
                                <p class="text-primary font-bold">5.0</p>
                            </div>
                            <div class="text-center">
                                <p
                                    class="text-[10px] uppercase font-label-md text-white/30"
                                >
                                    Service
                                </p>
                                <p class="text-primary font-bold">4.5</p>
                            </div>
                            <div class="text-center">
                                <p
                                    class="text-[10px] uppercase font-label-md text-white/30"
                                >
                                    Vibe
                                </p>
                                <p class="text-primary font-bold">4.5</p>
                            </div>
                            <div class="text-center">
                                <p
                                    class="text-[10px] uppercase font-label-md text-white/30"
                                >
                                    Price
                                </p>
                                <p class="text-primary font-bold">4.0</p>
                            </div>
                        </div>
                    </article>
                </div>
            </section>
        </main>